# Baza
DB_SA_PASSWORD=
CONNECTION_STRING=Server=localhost,1433;Database=220182;User=sa;Password=;TrustServerCertificate=True;

# JWT
JWT_KEY=
JWT_ISSUER=SunnyRides
JWT_AUDIENCE=SunnyRidesClients
