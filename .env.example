RABBITMQ_PASSWORD=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Demo korisnici imaju adrese na rezervisanim domenama (@example.com,
# @sunnyrides.example), na koje mail nikad ne bi stigao. Upisi ovdje svoju adresu i
# njihovi mailovi ce stizati tebi, uz naznaku kome su bili namijenjeni. Stvarne
# adrese dobijaju mail normalno.
SMTP_PREUSMJERI_NA=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Vremenska zona agencije, za vremena u obavjestenjima, emailovima i porukama.
# U bazi su sva vremena UTC; ovo utice samo na ispis. Prazno znaci Europe/Sarajevo.
VREMENSKA_ZONA=Europe/Sarajevo
